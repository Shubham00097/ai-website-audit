{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand AI Readiness Audit Report",
  "type": "object",
  "required": ["site", "audited_at", "summary", "findings"],
  "properties": {
    "site": {
      "type": "string",
      "description": "The domain or URL that was audited"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when the audit was run"
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium", "low"],
      "properties": {
        "total_findings": {"type": "integer", "minimum": 0},
        "critical":       {"type": "integer", "minimum": 0},
        "high":           {"type": "integer", "minimum": 0},
        "medium":         {"type": "integer", "minimum": 0},
        "low":            {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "evidence", "suggested_action"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d{3}$",
            "description": "Finding ID in format F-001, F-002, ..."
          },
          "title": {
            "type": "string",
            "description": "Short, specific description of the finding"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "evidence": {
            "type": "string",
            "description": "Concrete, specific evidence observed during the audit"
          },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "properties": {
              "summary": {
                "type": "string",
                "description": "Specific, actionable remediation step"
              },
              "priority": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            }
          }
        }
      }
    },
    "proactive_suggestions": {
      "type": "array",
      "description": "Optional high-value improvements that are not detected defects.",
      "items": {
        "type": "object",
        "required": ["title", "rationale", "suggested_action"],
        "properties": {
          "title": {"type": "string"},
          "rationale": {"type": "string"},
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "properties": {
              "summary": {"type": "string"},
              "priority": {"type": "string", "enum": ["high", "medium", "low"]}
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional audit metadata",
      "properties": {
        "skills_run":    {"type": "array", "items": {"type": "string"}},
        "skills_failed": {"type": "array", "items": {"type": "string"}},
        "duration_seconds": {"type": "number"}
      }
    }
  }
}
